{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "hello",
    "Database": "events-command",
    "EventsCollection": "events"
  },
  "IdempotencyCache": {
    "SizeLimit": 1024,
    "CompactionPercentage": 0.25,
    "ExpirationScanFrequencyMinutes": 5,
    "CacheDurationHours": 24
  }
}
